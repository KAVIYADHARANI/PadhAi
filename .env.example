# ==========================================
# PadhAI Environment Configuration Template
# ==========================================

# Brand Configuration (Do not modify unless rebranding)
PRODUCT_NAME=PadhAI
MASCOT_NAME=Parama-AI

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql+psycopg://padhai:padhai@localhost:5432/padhai

# Auth (Firebase)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Service-account key (local dev / non-GCP environments).
# Download from: Firebase Console → Project settings → Service accounts → Generate new private key
# Store the file OUTSIDE the repository.  Never commit it.
# Leave empty when running on GCP (Cloud Run, GKE) — ADC is used automatically.
GOOGLE_APPLICATION_CREDENTIALS=

# Auth emulator — Dev/CI only.  Leave EMPTY for production or real-Firebase local dev.
# When set, the backend points at the local emulator and skips real token verification.
# The frontend must also set VITE_FIREBASE_AUTH_EMULATOR_HOST to the same value.
FIREBASE_AUTH_EMULATOR_HOST=

# --------------------------------------------------
# Local Development Setup Checklist
# --------------------------------------------------
# Option A – Real Firebase (recommended for dev):
#   1. Download the service-account key from Firebase Console (see above).
#   2. Set GOOGLE_APPLICATION_CREDENTIALS to its absolute path.
#   3. Leave FIREBASE_AUTH_EMULATOR_HOST empty.
#   4. Leave VITE_FIREBASE_AUTH_EMULATOR_HOST empty in frontend/.env.
#
# Option B – Emulator (CI / offline dev):
#   1. Install Firebase CLI: npm install -g firebase-tools
#   2. Run: firebase emulators:start --only auth
#   3. Set FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 (backend).
#   4. Set VITE_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 (frontend).
#   Both sides MUST agree on emulator vs real Firebase or auth will fail.

# LLM Gateway (Ordered failover chain)
# At least one provider API key is required for real LLM operations.
# If no keys are provided, tests use FakeLLM and FakeEmbedder automatically with zero network calls.
#
# Supported providers:
# - Groq (Recommended for ultra-fast generation): https://console.groq.com/keys
# - OpenRouter (Broad access to Llama 3.3, Claude, Gemini): https://openrouter.ai/keys
# - Google AI Studio (Gemini 1.5 Pro / Flash): https://aistudio.google.com/app/apikey
# - Cerebras (High throughput Llama): https://cloud.cerebras.ai/
LLM_CHAIN=groq,openrouter,google,cerebras
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
CEREBRAS_API_KEY=

# Model Slugs per provider (provider:model_slug separated by |)
# Smart models handle grounded tutoring, quiz generation, and roadmap planning.
# Fast models handle query rewrites, intent routing, and topic grouping.
MODEL_SMART=groq:llama-3.3-70b-versatile|openrouter:meta-llama/llama-3.3-70b-instruct|google:gemini-1.5-pro|cerebras:llama3.3-70b
MODEL_FAST=groq:llama-3.1-8b-instant|openrouter:meta-llama/llama-3.1-8b-instruct|google:gemini-1.5-flash|cerebras:llama3.1-8b
MODEL_VISION=                                   # Optional handwriting fallback

LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
USER_DAILY_LLM_CALLS=150
REQUEST_MAX_LLM_CALLS=6

# Embeddings (BGE-M3 1024-dimensional)
# Use 'openrouter' or 'groq' if your provider supports 1024-dim embeddings.
# Leave empty or set to 'fake' to use deterministic 1024-dim embeddings for local zero-cost testing.
EMBED_PROVIDER=
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024                                   # Fixed per index; halfvec(1024)
USE_HALFVEC=true                                 # Use halfvec(1024); set false for vector(1024)

# OCR (Indra)
OCR_BACKEND=indra
INDRA_OCR_MODEL_DIR=/models/indra-ocr
OCR_MODE=auto                                    # auto | ocr | text
OCR_THREADS=2
OCR_MATH=false
OCR_MIN_LINE_CONF=0.80
OCR_VLM_FALLBACK=false
MAX_UPLOAD_MB=25
MAX_PAGES_PER_DOC=300

# Router and Guardrails
ROUTER_MIN_CONFIDENCE=0.6
ROUTER_CONFIRM_BELOW=0.8                         # Confirm before write agents
RETRIEVAL_MIN_SCORE=                             # Tuned from eval_retrieval.py

# Persona
PERSONA_PACK=tanglish                            # tanglish | english
PERSONA_DEFAULT_TONE=balanced                    # full | balanced | serious | english_only
PERSONA_ADDRESS_TERM=boss                        # Neutral default

# Storage
STORAGE_BACKEND=local                            # local | s3
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

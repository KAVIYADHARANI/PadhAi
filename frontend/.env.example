# Frontend Environment Variables

# Backend API Base URL (empty for same-origin or Vite proxy)
VITE_API_BASE_URL=

# Firebase Client SDK Configuration (get these from Firebase Console -> Project Settings -> General -> Your Apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Auth Emulator in Dev (e.g. localhost:9099)
VITE_FIREBASE_AUTH_EMULATOR_HOST=
